{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal CLI agent that connects to the exam-live WebSocket gateway as a student and creates the declared submission files on this machine.",
  "scripts": {
    "cli": "ts-node src/cli.ts",
    "mock-agent": "ts-node src/mock-agent.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
