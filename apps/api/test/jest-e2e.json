{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "isolatedModules": true,
        "diagnostics": false
      }
    ]
  },
  "globalSetup": "<rootDir>/jest-e2e.global-setup.ts",
  "setupFiles": ["<rootDir>/jest-e2e.setup.ts"]
}
