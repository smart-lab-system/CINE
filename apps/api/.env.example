NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lab_admin:lab_admin_password@localhost:5442/lab_management
DATABASE_SCHEMA=lab_management
# E2E tests use a separate database — never lab_management (see src/database/e2e-database.ts).
E2E_DATABASE_URL=postgresql://lab_admin:lab_admin_password@localhost:5442/lab_management_e2e
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
REFRESH_TOKEN_TTL=7d
WEB_ORIGIN=http://localhost:3000

# MinIO (docker compose service `minio`, host ports 9020/9021)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9020
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lab_admin
MINIO_SECRET_KEY=lab_admin_password
MINIO_ROSTER_BUCKET=course-rosters
MINIO_EXAM_ROSTER_BUCKET=exam-rosters
MINIO_EXAM_PACKAGES_BUCKET=exam-packages
