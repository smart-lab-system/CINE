NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://examcollect_admin:examcollect_admin_password@localhost:5442/examcollect
DATABASE_SCHEMA=examcollect
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
REFRESH_TOKEN_TTL=7d
WEB_ORIGIN=http://localhost:3000

# Object storage (MinIO in dev, S3-compatible in prod) — submission files
# are NEVER written to the NestJS server's disk (CLAUDE.md Security rule 5);
# the agent PUTs straight to storage via a presigned URL.
#
# STORAGE_ENDPOINT is used BOTH for the server's own SDK calls (HeadObject)
# and as the host baked into the presigned URL handed to the agent, so it
# must be reachable from both. That holds for the documented dev setup
# (api + agent both on the host, MinIO's host port 9010 -> container 9000,
# see docker-compose.yml). If the api is ever moved INTO docker while
# agents stay on the host, this single value stops working for both and
# needs splitting into an internal/public pair.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_ACCESS_KEY=examcollect_admin
STORAGE_SECRET_KEY=examcollect_admin_password
STORAGE_BUCKET=examcollect-submissions
# Optional. MinIO ignores it, but the AWS SDK requires SOME region and
# a real S3 deployment needs the bucket's actual one. Defaults to us-east-1.
# STORAGE_REGION=us-east-1

# Redis — hàng đợi chấm điểm (BullMQ). CLAUDE.md: Redis dùng cho trạng thái
# sống và hàng đợi, KHÔNG dùng làm nơi lưu dữ liệu bền.
# 6390 là cổng HOST mà docker-compose map ra từ 6379 trong container.
REDIS_HOST=localhost
REDIS_PORT=6390
# Tuỳ chọn — dev không cần, nhưng khai sẵn để chuyển sang Redis có mật khẩu
# không phải sửa code.
REDIS_PASSWORD=
REDIS_DB=0

# Nhịp gọi model khi chấm. Mặc định giữ nguyên giá trị đã hardcode trước đây.
#
# Lý do đưa ra env: giới hạn TPM của tài khoản Anthropic phụ thuộc tier, và
# chưa xác minh được token đọc-từ-cache có tính vào TPM hay không. Chỉnh sẵn
# một con số theo một giới hạn chưa biết là đoán — đo bằng dòng log
# `token in=... cacheRead=...` sau một lượt chấm thật rồi mới chỉnh.
#
# GRADE_CONCURRENCY: bao nhiêu bài chạy SONG SONG.
# GRADE_RATE_*: trần THÔNG LƯỢNG (số job trên một khoảng thời gian). Hai thứ
#   này KHÁC NHAU — xem comment trong grading.processor.ts trước khi đổi.
# Khoá API Anthropic. KHÔNG đặt thì hệ thống rơi về KeywordGradingProvider
# (đối sánh từ khoá cục bộ, 0 token) và NÓI RA ở log khởi động — điểm sinh
# ra khi đó chỉ dùng để thử luồng, không dùng để chấm thật.
#
# Đặt nó vào .env (KHÔNG commit), không phải vào file này.
# ANTHROPIC_API_KEY=

GRADE_CONCURRENCY=5
GRADE_RATE_MAX=10
GRADE_RATE_DURATION_MS=1000

# ---- Chuỗi model chấm, theo thứ tự ưu tiên ----
#
# Tầng 1 và 2 là API tương thích OpenAI (POST {BASE_URL}/chat/completions),
# dùng chung một adapter. Tầng 3 là Claude (ANTHROPIC_API_KEY ở trên).
# Sàn cuối cùng là KeywordGradingProvider — luôn có, không cần cấu hình,
# không bao giờ tự duyệt điểm.
#
# Một tầng chỉ được bật khi CẢ BA biến của nó có giá trị. Thiếu một biến
# thì tầng đó bị bỏ qua và ghi log rõ ràng — không đoán, không mặc định.
#
# Đặt giá trị thật vào .env (KHÔNG commit), không phải vào file này.

# GRADING_TIERn_CEILING: trần tin cậy của bậc đó, khoảng (0, 1]. Mặc định 0.5.
# Trần của bậc ĐẦU TIÊN quyết định có bài nào được tự duyệt hay không: nó bị so
# với ngưỡng 0.85, nên để mặc định thì MỌI bài đều chuyển giảng viên. Đó là chủ
# đích — nâng trần là việc của calibration (spec §11), không phải của một lần đoán.
# Giá trị rỗng hoặc ngoài khoảng bị bỏ qua và dùng mặc định.

# GRADING_TIER1_BASE_URL=https://api.b.ai/v1
# GRADING_TIER1_MODEL=qwen3.8-flash
# GRADING_TIER1_API_KEY=
# GRADING_TIER1_CEILING=0.5

# GRADING_TIER2_BASE_URL=
# GRADING_TIER2_MODEL=
# GRADING_TIER2_API_KEY=
# GRADING_TIER2_CEILING=0.5
