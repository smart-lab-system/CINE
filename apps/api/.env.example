NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://examcollect_admin:examcollect_admin_password@localhost:5442/examcollect
DATABASE_SCHEMA=examcollect
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
REFRESH_TOKEN_TTL=7d
WEB_ORIGIN=http://localhost:3000

# Object storage (MinIO in dev, S3-compatible in prod) — submission files
# are NEVER written to the NestJS server's disk (CLAUDE.md Security rule 5);
# the agent PUTs straight to storage via a presigned URL.
#
# STORAGE_ENDPOINT is used BOTH for the server's own SDK calls (HeadObject)
# and as the host baked into the presigned URL handed to the agent, so it
# must be reachable from both. That holds for the documented dev setup
# (api + agent both on the host, MinIO's host port 9010 -> container 9000,
# see docker-compose.yml). If the api is ever moved INTO docker while
# agents stay on the host, this single value stops working for both and
# needs splitting into an internal/public pair.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_ACCESS_KEY=examcollect_admin
STORAGE_SECRET_KEY=examcollect_admin_password
STORAGE_BUCKET=examcollect-submissions
# Optional. MinIO ignores it, but the AWS SDK requires SOME region and
# a real S3 deployment needs the bucket's actual one. Defaults to us-east-1.
# STORAGE_REGION=us-east-1
