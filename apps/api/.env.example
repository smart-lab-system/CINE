NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://examcollect_admin:examcollect_admin_password@localhost:5442/examcollect
DATABASE_SCHEMA=examcollect

# TLS cho kết nối Postgres. Để trống/không phải 'true' = TẮT, đúng cho
# Docker Postgres ở local (image postgres:16 không bật TLS, mở lên sẽ lỗi
# connect chứ không phải cảnh báo).
#
# Supabase / mọi managed Postgres: BẮT BUỘC đặt true.
# Connection string dùng Session pooler cổng 5432, KHÔNG dùng Transaction
# pooler 6543 — transaction mode không giữ session state và cấm prepared
# statement, TypeORM (pool sống dài, không phải serverless) sẽ lỗi lắt nhắt.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
#   DATABASE_SSL=true
DATABASE_SSL=false

# Đường dẫn tới CA bundle của Supabase (Dashboard -> Settings -> Database ->
# SSL certificate). Bỏ trống thì kết nối VẪN mã hoá nhưng KHÔNG xác thực
# server — tức không phát hiện được man-in-the-middle. Đặt nó vào ngay khi
# file CA có thể deploy kèm API.
# DATABASE_SSL_CA=/etc/ssl/certs/supabase-ca.crt
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
REFRESH_TOKEN_TTL=7d
WEB_ORIGIN=http://localhost:3000

# Object storage (MinIO in dev, S3-compatible in prod) — submission files
# are NEVER written to the NestJS server's disk (CLAUDE.md Security rule 5);
# the agent PUTs straight to storage via a presigned URL.
#
# STORAGE_ENDPOINT is used BOTH for the server's own SDK calls (HeadObject)
# and as the host baked into the presigned URL handed to the agent, so it
# must be reachable from both. That holds for the documented dev setup
# (api + agent both on the host, MinIO's host port 9010 -> container 9000,
# see docker-compose.yml). If the api is ever moved INTO docker while
# agents stay on the host, this single value stops working for both and
# needs splitting into an internal/public pair.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_ACCESS_KEY=examcollect_admin
STORAGE_SECRET_KEY=examcollect_admin_password
STORAGE_BUCKET=examcollect-submissions
# Optional. MinIO ignores it, but the AWS SDK requires SOME region and
# a real S3 deployment needs the bucket's actual one. Defaults to us-east-1.
# STORAGE_REGION=us-east-1

# ---- Redis/Valkey: hàng đợi chấm điểm (BullMQ) ----
#
# CLAUDE.md: Redis dùng cho trạng thái sống và hàng đợi, KHÔNG dùng làm nơi
# lưu dữ liệu bền — không có sự thật nào chỉ tồn tại ở đây.
#
# Hai cách khai, REDIS_URL thắng khi có mặt (shared/redis-connection.ts).
#
# CÁCH 1 — REDIS_URL, cho Redis managed. Aiven, Upstash, Render, Railway đều
# phát credential dạng URI này; dán nguyên, đừng tách tay thành 5 biến (5 cơ
# hội gõ sai, và cái sai biểu hiện y hệt sai mật khẩu).
#
#   REDIS_URL=rediss://default:<password>@<host>:<port>
#
#   - Scheme "rediss://" HAI chữ s = TLS. Một chữ s ("redis://") là plaintext.
#   - Password có ký tự đặc biệt phải percent-encode.
#   - Database LUÔN là 0: Aiven và Upstash đều chỉ có db 0.
#   - Upstash: cặp UPSTASH_REDIS_REST_* KHÔNG dùng được — đó là HTTP API, còn
#     BullMQ cần TCP thật (blocking command, Lua, pipeline). Nhưng REST token
#     CHÍNH LÀ password TCP, nên ghép được thành URL (kiểm 2026-09-17).
#
# CÁCH 2 — các biến rời bên dưới, cho Redis tự dựng (docker-compose).
# Chỉ được đọc khi REDIS_URL trống.
#
# ĐỘ TRỄ — đo 2026-09-17 từ máy ở VN, quan trọng hơn vẻ ngoài của nó:
#
#   Redis docker local   ~1ms mỗi lệnh   |  10 lệnh tuần tự:    7ms
#   Aiven / Upstash    ~270ms mỗi lệnh   |  10 lệnh tuần tự: ~2500ms
#
# Một job BullMQ tốn nhiều lệnh, nên chênh lệch này là GIÂY chứ không phải
# mili giây. Khi BE còn chạy local thì để trống REDIS_URL; chỉ trỏ lên cloud
# khi BE đã nằm cạnh nó.

# 6390 là cổng HOST mà docker-compose map ra từ 6379 trong container.
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=
REDIS_DB=0
# TLS: Redis trong docker-compose không phục vụ TLS, bật lên là lỗi handshake.
REDIS_TLS=false

# Nhịp gọi model khi chấm. Mặc định giữ nguyên giá trị đã hardcode trước đây.
#
# Lý do đưa ra env: giới hạn TPM của tài khoản Anthropic phụ thuộc tier, và
# chưa xác minh được token đọc-từ-cache có tính vào TPM hay không. Chỉnh sẵn
# một con số theo một giới hạn chưa biết là đoán — đo bằng dòng log
# `token in=... cacheRead=...` sau một lượt chấm thật rồi mới chỉnh.
#
# GRADE_CONCURRENCY: bao nhiêu bài chạy SONG SONG.
# GRADE_RATE_*: trần THÔNG LƯỢNG (số job trên một khoảng thời gian). Hai thứ
#   này KHÁC NHAU — xem comment trong grading.processor.ts trước khi đổi.
# Khoá API Anthropic. KHÔNG đặt thì hệ thống rơi về KeywordGradingProvider
# (đối sánh từ khoá cục bộ, 0 token) và NÓI RA ở log khởi động — điểm sinh
# ra khi đó chỉ dùng để thử luồng, không dùng để chấm thật.
#
# Đặt nó vào .env (KHÔNG commit), không phải vào file này.
# ANTHROPIC_API_KEY=

# Gateway thay cho api.anthropic.com, nếu bạn mua Claude qua trung gian.
#
# TÊN BIẾN PHẢI ĐÚNG LÀ `ANTHROPIC_BASE_URL` — đây là biến SDK Anthropic
# tự đọc. Một `.env` từng khai `ANTHROPIC_URL` và hỏng trong im lặng:
# không code nào đọc tên đó, SDK gọi thẳng api.anthropic.com, và tầng
# Claude chết ở mọi bài vì tài khoản gốc không có credit. Không log nào
# nói ra, vì với SDK thì chẳng có gì bất thường cả.
#
# Nhớ kiểm khoá của gateway có đăng ký đúng model trong GRADER_MODEL /
# ADVOCATE_MODEL không — thiếu thì nó trả 403 và cả tầng Claude bị bỏ qua.
# SDK tự nối `/v1` vào sau, nên KHÔNG kèm `/v1` ở đây (kèm vào sẽ ra
# /v1/v1/messages → 404). Khác tier1/tier2 bên dưới: chúng ghép đường dẫn
# thủ công nên PHẢI có /v1.
# ANTHROPIC_BASE_URL=https://api.vilao.ai

# GRADE_JOB_TIMEOUT_MS: tran thoi gian cho MOT bai, mac dinh 300000 (5 phut).
# Do 2026-09-15 tren qwen3.8-flash: cham ~46s + phan bien ~61s = ~107s. Tran
# cu 120s chon hoi chi co Claude va khong con du. Nang len neu chuoi co bac
# cham hon; ha xuong neu moi bac deu nhanh.
# GRADE_JOB_TIMEOUT_MS=300000
# GRADING_ADVOCATE_TIMEOUT_MS=150000

GRADE_CONCURRENCY=5
GRADE_RATE_MAX=10
GRADE_RATE_DURATION_MS=1000

# ---- Chuỗi model chấm, theo thứ tự ưu tiên ----
#
# Tầng 1 và 2 là API tương thích OpenAI (POST {BASE_URL}/chat/completions),
# dùng chung một adapter. Tầng 3 là Claude (ANTHROPIC_API_KEY ở trên).
# Sàn cuối cùng là KeywordGradingProvider — luôn có, không cần cấu hình,
# không bao giờ tự duyệt điểm.
#
# Một tầng chỉ được bật khi CẢ BA biến của nó có giá trị. Thiếu một biến
# thì tầng đó bị bỏ qua và ghi log rõ ràng — không đoán, không mặc định.
#
# Đặt giá trị thật vào .env (KHÔNG commit), không phải vào file này.

# GRADING_TIERn_CEILING: trần tin cậy của bậc đó, khoảng (0, 1]. Mặc định 0.5.
# Trần của bậc ĐẦU TIÊN quyết định có bài nào được tự duyệt hay không: nó bị so
# với ngưỡng 0.85, nên để mặc định thì MỌI bài đều chuyển giảng viên. Đó là chủ
# đích — nâng trần là việc của calibration (spec §11), không phải của một lần đoán.
# Giá trị rỗng hoặc ngoài khoảng bị bỏ qua và dùng mặc định.

# GRADING_TIER1_BASE_URL=https://api.b.ai/v1
# GRADING_TIER1_MODEL=qwen3.8-flash
# GRADING_TIER1_API_KEY=
# GRADING_TIER1_CEILING=0.5

# GRADING_TIER2_BASE_URL=
# GRADING_TIER2_MODEL=
# GRADING_TIER2_API_KEY=
# GRADING_TIER2_CEILING=0.5

# ---- Anchor: few-shot tu lan sua THAT cua giang vien (spec §10) ----
#
# MAC DINH TAT, va day la quyet dinh chu khong phai gia tri khoi tao.
# Anchor LA nhanh D cua calibration, tuc mot THI NGHIEM — va mot thu dang
# duoc thi nghiem khong duoc phep la mac dinh cua he thong cham diem that.
#
# Bat no kich hoat cung luc ba rui ro chua ai do: vong lap neo (he hoi tu
# ve dung thien lech ban dau cua AI, siet dan trong im lang), anchor mau
# thuan (thay noi tay voi em A, siet voi em B), va loang chu y.
#
# CHI bat sau khi calibration nhanh D chung minh no giup (§10.0).
# Gia tri phai dung chuoi 'true'; moi gia tri khac deu la tat.
# GRADING_ANCHORS_ENABLED=false
