# Cấu hình HẠ TẦNG cho bộ e2e. Nạp bởi test/setup-env.ts với `override: true`,
# trước khi bất kỳ spec nào import AppModule.
#
# File này ĐƯỢC commit, khác với `.env`: nó chỉ chứa thông tin của
# docker-compose.yml ở local — không có secret thật nào. Ai clone repo về là
# chạy e2e được ngay.
#
# Vì sao nó tồn tại (2026-09-17): `.env` đã trỏ sang Supabase cloud. Mọi spec
# đều `import { AppModule }` -> `dataSourceOptions` -> `process.env.DATABASE_URL`,
# và trước đây `jest-e2e.json` không override gì cả. Nghĩa là `test:e2e` sẽ
# ghi/xoá thẳng trên database thật. E2E vốn KHÔNG tự dọn dữ liệu, nên hậu quả
# không dừng ở "bẩn" mà là rác vĩnh viễn trên DB đang chạy demo.
#
# Mọi biến trỏ tới hạ tầng PHẢI khai ở đây, kể cả khi trùng `.env`. Biến nào
# thiếu sẽ rơi xuống `.env` — tức là rơi ra cloud, đúng thứ file này sinh ra để
# ngăn.

NODE_ENV=test
PORT=4000

# Postgres trong docker-compose.yml (cổng host 5442 -> 5432 trong container).
DATABASE_URL=postgresql://examcollect_admin:examcollect_admin_password@localhost:5442/examcollect
DATABASE_SCHEMA=examcollect
DATABASE_SSL=false

# Redis trong docker-compose.yml (cổng host 6390 -> 6379). KHÔNG dùng Upstash:
# ngoài chuyện tốn quota, một bộ e2e chạy song song với dev/CI trên cùng một
# Redis sẽ giành job của nhau — chính lỗi đã mất một buổi để tìm ra 2026-09-15
# (xem comment `prefix` trong app.module.ts).
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# MinIO trong docker-compose.yml (cổng host 9010 -> 9000).
# Bucket `examcollect-submissions` KHÔNG tự tạo — thiếu nó, backup.e2e-spec.ts
# fail với STORAGE_UNAVAILABLE thay vì NO_BACKUP, trông y hệt lỗi nghiệp vụ.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_ACCESS_KEY=examcollect_admin
STORAGE_SECRET_KEY=examcollect_admin_password
STORAGE_BUCKET=examcollect-submissions
STORAGE_REGION=us-east-1

ACCESS_TOKEN_SECRET=test-access-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=test-refresh-secret
REFRESH_TOKEN_TTL=7d
WEB_ORIGIN=http://localhost:3000

# Không khai GRADING_TIER*_ / ANTHROPIC_API_KEY: chuỗi chấm rơi về
# KeywordGradingProvider (0 token, không gọi mạng). grading.module.ts còn một
# guard NODE_ENV==='test' nữa, nhưng không dựa vào nó một mình — một biến rò
# từ `.env` sang là đủ để một lần chạy e2e tốn tiền thật.
